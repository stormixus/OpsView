# OpsView relay deployment config.
# Copy to `relay/.env` and fill in, then: docker compose pull && docker compose up -d
# (relay/.env is gitignored.)

# REQUIRED. Shared secret the agent must also present (its
# RELAY_PUBLISHER_TOKEN or AGENT_TOKEN must equal this). The relay refuses to
# start without it. Generate one with:  openssl rand -hex 32
RELAY_PUBLISHER_TOKEN=change-me-publisher-secret

# Optional. External (host) port published to the internet. Default 28186.
#RELAY_EXTERNAL_PORT=28186

# Optional. Comma-separated WebSocket Origin allowlist for browser viewers.
# Empty = accept any Origin. Native clients (agent, desktop viewer) are always allowed.
#RELAY_ALLOWED_ORIGINS=https://viewer.example.com,https://ops.example.com
