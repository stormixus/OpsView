# === Relay ===
RELAY_PORT=8080
# REQUIRED: shared secret a publisher (agent) must present to claim the publisher
# slot. The relay refuses to start if this is empty (falls back to AGENT_TOKEN).
# This is NOT the viewer PIN — viewers still authenticate with the 6-digit PIN.
RELAY_PUBLISHER_TOKEN=change-me-publisher-secret
RELAY_WEB_DIR=../web

# === Agent ===
AGENT_RELAY_URL=ws://127.0.0.1:8080/publish
# Must match the relay's RELAY_PUBLISHER_TOKEN (the agent also reads RELAY_PUBLISHER_TOKEN).
AGENT_TOKEN=change-me-publisher-secret
AGENT_PROFILE=1080
AGENT_FPS_MIN=5
AGENT_FPS_MAX=10
AGENT_TILE_SIZE=128

# === Viewer / Web ===
WATCH_URL=ws://127.0.0.1:8080/watch
WATCH_TOKEN=watcher-token-1
